            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Book\",\n  \"author\": \"Test Author\",\n  \"isbn\": \"9780000000002\",\n  \"description\": \"Created from the Postman collection.\",\n  \"totalCopies\": 5,\n  \"genreId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"availableCopies equals totalCopies\", function () { const b = pm.response.json(); pm.expect(b.availableCopies).to.eql(b.totalCopies); });",
                  "pm.collectionVariables.set(\"bookId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
