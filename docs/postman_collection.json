              "raw": "{{baseUrl}}/genres/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres",
                "1"
              ]
            },
            "description": "Genre 1 still has books, so deleting it is refused."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
